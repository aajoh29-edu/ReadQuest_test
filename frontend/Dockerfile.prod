# ---------------------------------------
# Stage 1: Build the Vite React application
# ---------------------------------------
FROM node:24-alpine AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy dependency manifests first to leverage Docker layer caching
COPY package*.json ./

# Install dependencies using npm ci for strict, clean installs
RUN npm ci

# Copy the rest of the frontend source code
COPY . .

# Build the production assets (outputs to /app/dist)
# The Vite plugin we configured will automatically delete demo.html here
RUN npm run build

# ---------------------------------------
# Stage 2: Serve with Nginx
# ---------------------------------------
FROM nginx:alpine

# Remove the default Nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy the custom Nginx configuration we created earlier
# This assumes you saved the config file as 'nginx.conf' in the frontend/ directory
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the compiled React assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80 for Docker networking (mapped in docker-compose)
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
