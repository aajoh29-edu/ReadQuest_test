digraph ReadQuest {
  rankdir=LR;
  node [shape=record];
  activities [label="{activities|id\llesson_id\ltitle\lactivity_type\lprompt\lcontent\ldifficulty\lsequence\lstatus\l}"];
  lessons -> activities [label="lesson_id"];
  activity_skills [label="{activity_skills|activity_id\lskill_id\lweight\l}"];
  activities -> activity_skills [label="activity_id"];
  skills -> activity_skills [label="skill_id"];
  attempts [label="{attempts|id\lchild_id\lactivity_id\lis_correct\lresponse_ms\lanswer\loccurred_at\lcreated_at\l}"];
  child_profiles -> attempts [label="child_id"];
  activities -> attempts [label="activity_id"];
  auth_sessions [label="{auth_sessions|token_hash\luser_id\lexpires_at\l}"];
  users -> auth_sessions [label="user_id"];
  child_profiles [label="{child_profiles|id\luser_id\ldisplay_name\lgrade_level\lcurrent_level\lcreated_at\l}"];
  users -> child_profiles [label="user_id"];
  classes [label="{classes|id\lteacher_id\lname\ljoin_code\lstatus\lcreated_at\l}"];
  users -> classes [label="teacher_id"];
  enrollments [label="{enrollments|class_id\lchild_id\lenrolled_at\lstatus\l}"];
  classes -> enrollments [label="class_id"];
  child_profiles -> enrollments [label="child_id"];
  guardian_children [label="{guardian_children|guardian_id\lchild_id\lrelationship_label\lcreated_at\l}"];
  users -> guardian_children [label="guardian_id"];
  child_profiles -> guardian_children [label="child_id"];
  lessons [label="{lessons|id\ltitle\ldescription\lsequence\lstatus\lupdated_at\lcreated_at\l}"];
  login_throttles [label="{login_throttles|email\lfailures\lwindow_start\l}"];
  recommendations [label="{recommendations|id\lchild_id\lactivity_id\ltriggering_attempt_id\lpriority_score\lreason_code\lreason_details\lalgorithm_version\lstatus\lcreated_at\l}"];
  child_profiles -> recommendations [label="child_id"];
  activities -> recommendations [label="activity_id"];
  attempts -> recommendations [label="triggering_attempt_id"];
  skill_mastery [label="{skill_mastery|child_id\lskill_id\lscore\lband\lconfidence\lattempt_count\llast_practiced_at\lalgorithm_version\lversion\lupdated_at\l}"];
  child_profiles -> skill_mastery [label="child_id"];
  skills -> skill_mastery [label="skill_id"];
  skills [label="{skills|id\lcode\lname\lcategory\llevel\lstatus\l}"];
  users [label="{users|id\lemail\lpassword_hash\lrole\lstatus\lupdated_at\lcreated_at\l}"];
}
