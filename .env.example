READQUEST_ENV=development
READQUEST_DATABASE_URL=postgresql+psycopg://readquest:readquest@db:5432/readquest
READQUEST_LOG_LEVEL=INFO
POSTGRES_DB=readquest
POSTGRES_USER=readquest
POSTGRES_PASSWORD=readquest


# Development-only opt-in demo logins. Choose a throwaway 12–128 character
# password locally; leave blank to keep seeded accounts unable to sign in.
READQUEST_DEMO_PASSWORD=
READQUEST_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
READQUEST_SESSION_HOURS=8
# Production: set READQUEST_API_IMAGE and READQUEST_FRONTEND_IMAGE to release tags,
# use an external DB with unique credentials, and set HTTPS origins as JSON.
# Supply passwords securely at runtime; never commit a filled .env.
