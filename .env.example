# ReadQuest Frontend Environment Configuration Template
# Never place private database credentials, JWT secrets, or API keys in VITE_* variables.
# Frontend VITE_* variables are bundled into browser JavaScript and are publicly readable.

# Base URL for the backend API (no trailing slash).
# Leave empty or set to "/api/v1" when frontend and backend share the same HTTPS origin via reverse proxy.
# Example cross-origin HTTPS endpoint: https://api.readquest.example.com/api/v1
VITE_API_BASE_URL="/api/v1"

# Public display name
VITE_APP_NAME="ReadQuest"

# Enable sending X-CSRF-Token header read from the backend's non-HttpOnly CSRF cookie ("true" | "false")
VITE_ENABLE_CSRF_HEADER="true"

# Name of the non-HttpOnly CSRF cookie set by the backend for double-submit CSRF protection
VITE_CSRF_COOKIE_NAME="rq_csrf_token"

# Compose project and development ports
COMPOSE_PROJECT_NAME="readquest-dev"
DEV_FRONTEND_PORT="8080"
DEV_BACKEND_PORT="8000"
CHOKIDAR_USEPOLLING="true"
VITE_DEV_API_TARGET="http://backend:8000"

# Development PostgreSQL (replace before use outside local development)
POSTGRES_DB="readquest"
POSTGRES_USER="readquest"
POSTGRES_PASSWORD="replace-with-local-password"

# Development backend behavior
READQUEST_FRONTEND_URL="http://localhost:8080"
READQUEST_AUTO_VERIFY_EMAIL="true"
READQUEST_COOKIE_SECURE="false"
READQUEST_CSRF_COOKIE="rq_csrf_token"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_FROM="no-reply@readquest.local"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Lesson-tailoring model artifacts (set by compose; defaults to ./model_artifacts)
# READQUEST_MODEL_DIR="/var/lib/readquest/models"
READQUEST_LM_ORDER="3"
READQUEST_RETRAIN_EVERY_ATTEMPTS="25"
READQUEST_VALIDATION_FRACTION="0.2"

# Production overrides (provide through CI/CD secrets, never commit .env)
PROD_COMPOSE_PROJECT_NAME="readquest-prod"
PROD_FRONTEND_PORT="8081"
PROD_BACKEND_PORT="8001"
PROD_FRONTEND_URL="http://localhost:8081"
PROD_POSTGRES_DB="readquest"
PROD_POSTGRES_USER="readquest"
PROD_POSTGRES_PASSWORD="replace-through-ci-secret"
